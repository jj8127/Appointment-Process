{
  "expo": {
    "name": "모두온",
    "slug": "fc-onboarding-app",
    "version": "4.2.19",
    "orientation": "portrait",
    "icon": "./assets/images/moduon/moduon-app-icon.png",
    "scheme": "hanwhafcpass",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jj8127.fconboardingapp",
      "icon": "./assets/images/moduon/moduon-app-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "userInterfaceStyle": "light",
      "backgroundColor": "#ffffff",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/moduon/moduon-adaptive-foreground.png",
        "monochromeImage": "./assets/images/moduon/moduon-adaptive-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.jj8127.Garam_in"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/moduon/moduon-symbol.png"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "hanhwa-lifelab",
          "project": "react-native"
        }
      ],
      "./plugins/with-android-drawing-order-fix",
      [
        "expo-build-properties",
        {
          "android": {
            "buildReactNativeFromSource": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "kotlinVersion": "2.1.20",
            "kotlinJvmTarget": "17"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/moduon/moduon-monochrome.png",
          "color": "#f36f21"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/moduon/moduon-logo-primary.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e9a1f11-8b60-46f9-8af2-168188dbf3db"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e9a1f11-8b60-46f9-8af2-168188dbf3db"
    }
  }
}
